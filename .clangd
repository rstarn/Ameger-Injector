Diagnostics:
  UnusedIncludes: None
CompileFlags:
  Add:
    - -std=c++20
    - -ID:/Ameger/Injector/Ameger
    - -ID:/Ameger/Injector
    - -target
    - x86_64-pc-windows-msvc
    - -fms-compatibility
    - -fdelayed-template-parsing
    - -fexceptions
    - -Wno-microsoft-cast
    - -Wno-microsoft-enum-value
    - -Wno-microsoft-exception-spec
    - -Wno-msvc-include
    - -DWIN32
    - -D_WIN64
    - -D_WINDOWS
    - -DUNICODE
    - -D_UNICODE
    - -DNTDDI_VERSION=0x0A00000C
    - -D_WIN32_WINNT=0x0A00
    - -DNOMINMAX
